[0m07:18:22.037108 [debug] [Thread-2 (]: On model.luxe_training.fact_stockout_rate: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "luxe_training", "target_name": "dwh", "node_id": "model.luxe_training.fact_stockout_rate"} */
create or replace transient table luxe_training.dwh.fact_stockout_rate
         as
        (SELECT
    product_id,
    store_id,

    COUNT(*) AS days_observed,

    SUM(is_stockout) AS stockout_days,

    ROUND(
        SUM(is_stockout) * 100.0 / COUNT(*),
        2
    ) AS stockout_rate

FROM luxe_training.dwh.int_inventory_stockout

GROUP BY
    product_id,
    store_id
        );
